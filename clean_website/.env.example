# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already gitignored) -- in production (Render), set these as
# environment variables in the service dashboard instead.

# ---- Database ----
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Auth ----
SESSION_SECRET=replace-with-a-long-random-string

# ---- Sign in with Google (lib/google-auth.ts, routes/auth.ts) ----
# OAuth Client ID from Google Cloud Console (APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application). Not a
# secret -- it's served back to the frontend by GET /auth/google-client-id
# and ends up in the browser either way. Leave unset to keep the Google
# button hidden and POST /auth/google rejecting with 503.
GOOGLE_CLIENT_ID=

# ---- AI providers ----
GEMINI_API_KEY=
# Comma-separated list of Gemini keys for rotation under rate limits (optional,
# overrides GEMINI_API_KEY if set).
GEMINI_API_KEYS=
# Audio transcription (lib/extractor.ts's transcribeAudio, OpenAI's own
# Whisper API -- whisper-1).
OPENAI_API_KEY=

# ---- CORS (production only) ----
# Comma-separated list of additional allowed origins beyond *.vercel.app and
# localhost, e.g. https://focusstudy.net
CORS_ORIGINS=

# ---- Frontend URL (routes/billing.ts's /webhooks/hyp/return) ----
# Where to redirect the browser back to (with ?purchase=success&tokens=N)
# once a Max Business/Hyp payment is verified. Defaults to
# https://focusstudy.net if unset.
FRONTEND_URL=

# ---- Logging ----
LOG_LEVEL=info

# ---- Billing: Max Business / Hyp Pay (live hosted checkout, routes/billing.ts, lib/hyp.ts) ----
# Token top-up purchases. HYP_MASOF is the terminal number, HYP_API_KEY /
# HYP_API_PASSWORD (a.k.a. "PassP") authenticate every call to
# https://pay.hyp.co.il/p/ -- all three come from the Hyp Portal
# (Settings -> "API-דף תשלום" -> "אימות"). A test terminal's number always
# starts with 00100; switch all three to the production values (the API URL
# itself never changes) when ready to accept real payments.
HYP_MASOF=
HYP_API_KEY=
HYP_API_PASSWORD=

# ---- Billing: Zapier/Bit-PayBox (legacy webhook, routes/billing.ts) ----
# Shared secret the Zapier automation sends as X-Zapier-Secret when it
# detects a Bit/PayBox payment notification. Leave unset to keep this
# webhook route rejecting all requests with 404.
ZAPIER_WEBHOOK_SECRET=

# ---- Contact Us form (lib/email.ts, routes/contact.ts) ----
# Brevo API key (https://app.brevo.com/settings/keys/api) used to send
# Contact Us submissions over HTTPS. Leave unset to reject contact-form
# submissions with an error (fails closed -- never silently drops a message).
BREVO_API_KEY=
# Sender address -- must be verified under Brevo's Senders settings. The
# focusstudy.net addresses aren't domain-verified there yet, so this has to
# stay the Gmail address until that's done. Defaults to
# focusstudy.net@gmail.com if unset.
CONTACT_FROM_EMAIL=
# Display name for the sender. Defaults to "FocusStudy" if unset.
CONTACT_FROM_NAME=
# Inbox that receives Contact Us submissions. Defaults to
# focusstudy.net@gmail.com if unset.
CONTACT_TO_EMAIL=

# ---- Cron: daily reminder emails (routes/cron.ts, .github/workflows/daily-reminders.yml) ----
# Shared secret the GitHub Actions workflow sends as X-Cron-Secret to trigger
# the daily "cards due" / "exam coming up" reminder email. Leave unset to
# keep this route rejecting all requests with 404. Must also be set as the
# CRON_SECRET repository secret in GitHub so the workflow can send it.
CRON_SECRET=
