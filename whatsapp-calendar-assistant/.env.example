# --- Server ---
PORT=3000

# --- WhatsApp Cloud API (Meta) ---
# Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose. Enter the same value in the Meta webhook config screen.
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > your app > App Settings > Basic > App Secret
# Used to verify that incoming webhook requests really came from Meta.
WHATSAPP_APP_SECRET=

# --- OpenAI Whisper (audio transcription) ---
OPENAI_API_KEY=

# --- Claude (intent parsing) ---
ANTHROPIC_API_KEY=

# --- Google Calendar ---
# From a Google Cloud OAuth 2.0 Client ID (Desktop app or Web app type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# One-time refresh token obtained via the OAuth consent flow (see README).
GOOGLE_REFRESH_TOKEN=

# IANA timezone used to interpret relative dates ("tomorrow at 3pm") and to
# create/read calendar events, e.g. America/New_York, Europe/London.
DEFAULT_TIMEZONE=America/New_York
